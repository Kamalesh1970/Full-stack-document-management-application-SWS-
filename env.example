# OpenRouter key (or any OpenAI compatible API). Leave empty to use mock answers
LLM_API_KEY=
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free

# Local MongoDB or an Atlas connection string (mongodb+srv://user:pass@cluster.../)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=document_assistant

# Uploaded files are stored here
DATA_DIR=data
MAX_FILE_SIZE_MB=5
CORS_ORIGINS=*
